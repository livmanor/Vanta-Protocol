# City configuration (Hyderabad pilot area)
CITY_NAME=Hyderabad
DEFAULT_LAT=17.3914
DEFAULT_LNG=78.4702
BBOX_MIN_LAT=17.15
BBOX_MIN_LNG=78.30
BBOX_MAX_LAT=17.50
BBOX_MAX_LNG=78.57

# External Public APIs (all free, no keys needed)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
OPEN_ELEVATION_URL=https://api.open-elevation.com/api/v1/lookup
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSRM_ROUTE_URL=https://router.project-osrm.org/route/v1/driving
BLOCKED_ROAD_BUFFER_M=30
HEAT_PLAIN_THRESHOLD_C=40
HEAT_SEVERE_APPARENT_THRESHOLD_C=45

# Cache TTL (seconds) to respect API rate limits
WEATHER_CACHE_TTL=900
FLOOD_CACHE_TTL=1800
ELEVATION_CACHE_TTL=86400
OSM_CACHE_TTL=3600

# Gemini-backed Prepare and Respond agents (keep the real key only in .env)
GEMINI_API_KEY=
# Primary model. gemini-2.5-flash is documented to reroute on 2026-12-01 — keep fallbacks listed.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-flash-latest

# Groq-backed Predict Agent (keep the real key only in .env)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# SOS SMS (safe by default: messages are logged only, no SMS is sent)
SMS_PROVIDER=twilio
SMS_TEST_MODE=true
SMS_SENDER=
SMS_HELPLINE=[HELPLINE]
SMS_DLT_TEMPLATE_ID=
SMS_STATUS_CALLBACK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Server
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PORT=8000
HOST=0.0.0.0
DATABASE_PATH=./vanta.db

# Local officer login (bcrypt in SQLite). No cloud IdP.
# Set AUTH_REQUIRED=true in production. The bootstrap account is created once on startup.
AUTH_REQUIRED=true
BOOTSTRAP_OFFICER_USERNAME=officer
BOOTSTRAP_OFFICER_PASSWORD=off123
BOOTSTRAP_OFFICER_DISPLAY_NAME=Officer
SESSION_TTL_HOURS=12
AUTH_COOKIE_SECURE=false

# CAP 1.2 official alerts (SACHET primary; IMD CAP RSS also polled)
CAP_RSS_URLS=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml,https://cap-sources.s3.amazonaws.com/in-imd-en/rss.xml
CAP_ALLOWED_HOSTS=sachet.ndma.gov.in,cap-sources.s3.amazonaws.com
CAP_POLL_SECONDS=300
CAP_HTTP_TIMEOUT_SECONDS=5
CAP_MAX_BODY_BYTES=1048576
CAP_MAX_ITEMS_PER_POLL=40
# Greater Hyderabad LGD codes: Hyderabad, Medchal-Malkajgiri, Ranga Reddy, Sangareddy
CAP_HYD_DISTRICT_CODES=507,700,518,691
CAP_FLOOR_ORANGE=watch
CAP_FLOOR_RED=heavy

# Hyderabad Traffic Police live waterlogging list (HTML). Default: all GHMC divisions.
# Use HTP_ZONE_FILTER=Khairatabad or Khairatabad,Golconda to narrow.
HTP_WATERLOGGING_URL=https://echallan.tspolice.gov.in/htp/water_logging.html
HTP_ZONE_FILTER=all
HTP_POLL_SECONDS=900
HTP_HTTP_TIMEOUT_SECONDS=15
HTP_MAX_BODY_BYTES=2000000

# NASA FIRMS wildfire / thermal anomalies (free MAP_KEY; never commit the real key)
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
MAP_KEY=
NASA_FIRMS_MAP_KEY=

