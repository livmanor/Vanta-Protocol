# City configuration (defaults to Chennai / Adyar & Cooum basin - high flood/cyclone coastal zone)
CITY_NAME=Chennai
DEFAULT_LAT=13.0827
DEFAULT_LNG=80.2707
BBOX_MIN_LAT=12.90
BBOX_MIN_LNG=80.12
BBOX_MAX_LAT=13.20
BBOX_MAX_LNG=80.32

# External Public APIs (all free, no keys needed)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
OPEN_ELEVATION_URL=https://api.open-elevation.com/api/v1/lookup
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSRM_ROUTE_URL=https://router.project-osrm.org/route/v1/driving

# Cache TTL (seconds) to respect API rate limits
WEATHER_CACHE_TTL=900
FLOOD_CACHE_TTL=1800
ELEVATION_CACHE_TTL=86400
OSM_CACHE_TTL=3600

# Server
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite+aiosqlite:///./vanta.db

