# City configuration (Hyderabad pilot area)
CITY_NAME=Hyderabad
DEFAULT_LAT=17.3914
DEFAULT_LNG=78.4702
BBOX_MIN_LAT=17.15
BBOX_MIN_LNG=78.30
BBOX_MAX_LAT=17.50
BBOX_MAX_LNG=78.57

# External Public APIs (all free, no keys needed)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
OPEN_ELEVATION_URL=https://api.open-elevation.com/api/v1/lookup
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSRM_ROUTE_URL=https://router.project-osrm.org/route/v1/driving

# Cache TTL (seconds) to respect API rate limits
WEATHER_CACHE_TTL=900
FLOOD_CACHE_TTL=1800
ELEVATION_CACHE_TTL=86400
OSM_CACHE_TTL=3600

# Gemini-backed Predict and Prepare agents (keep the real key only in .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Server
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite+aiosqlite:///./vanta.db

